# Frontend Environment Variables
# Copy this file to .env and update the values

# API URL (without /api suffix - will be used for both REST API and Socket.io)
# For local development:
VITE_API_URL=http://localhost:5000

# For production:
# VITE_API_URL=https://seoul-brew-cafe-backend-9d3v.onrender.com

# Note: The API client will automatically append /api to REST calls
# and remove /api for Socket.io connections

